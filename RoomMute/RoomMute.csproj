<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><AssemblyName>RoomMute</AssemblyName>
    <ApplicationIcon>Resources\Icons\RoomMute.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><Version>1.7.0</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" /><ProjectReference Include="../RoomMute.Core/RoomMute.Core.csproj" /><PackageReference Include="NAudio.Wasapi" Version="2.3.0" /></ItemGroup>
  <PropertyGroup><NoiseRuntime Condition="'$(RuntimeIdentifier)' == ''">win-x64</NoiseRuntime><NoiseRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NoiseRuntime></PropertyGroup>
  <ItemGroup><Content Include="../native/$(NoiseRuntime)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Content Include="../models/silero_vad.onnx" Link="Models/silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup></Project>
