<UserControl Background="{StaticResource BackgroundBrush}" x:Class="RoomMute.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:RoomMute.Views">
<UserControl.Resources>
 <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="13"/>
 </Style>
 <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="CompactSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
  <Setter Property="Height" Value="23"/><Setter Property="Margin" Value="0,4,0,0"/>
 </Style>
 <Style x:Key="CompactCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
  <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="12"/>
 </Style>
</UserControl.Resources>
<Grid x:Name="DashboardRoot" Margin="22,16">
 <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
  <RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal">
   <Border Background="#1B3834" CornerRadius="12" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="≋" FontSize="31" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel><TextBlock Text="RoomMute" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding Text[Subtitle]}" Style="{StaticResource MutedText}"/></StackPanel>
  </StackPanel>
  <Border Grid.Column="1" Background="#141E2B" CornerRadius="18" Padding="12,8" VerticalAlignment="Center" Margin="12,0">
   <StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding ConnectionBrush}" Width="7" Height="7" Margin="0,0,8,0"/>
    <TextBlock Text="{Binding ConnectionText}" MaxWidth="240" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding ConnectionText}"/>
   </StackPanel>
  </Border>
  <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedValuePath="Code" DisplayMemberPath="Label"
    SelectedValue="{Binding Language, Mode=TwoWay}" Width="118" Margin="0" VerticalAlignment="Center"
    ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[Language]}" AutomationProperties.Name="{Binding Text[Language]}"/>
 </Grid>

 <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Background="#142A29" BorderBrush="#285349">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding MicrophoneState}" Foreground="{Binding MicrophoneBrush}" FontSize="21" FontWeight="Bold"/>
    <TextBlock Text="{Binding MicrophoneHint}" Foreground="#B3C8C4" Margin="0,4,18,0" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding MicrophoneHint}"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{Binding Text[Start]}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center" Padding="18,9"/>
   <Button Grid.Column="2" Content="{Binding Text[Stop]}" Command="{Binding StopCommand}" VerticalAlignment="Center" Padding="16,9"/>
  </Grid>
 </Border>

 <Grid Grid.Row="4">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
  <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="16,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Text[Local]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Settings.AudioDeviceId, Mode=TwoWay}" Margin="0,0,7,0" AutomationProperties.Name="{Binding Text[Local]}"/>
     <Button Grid.Column="1" Content="↻" Command="{Binding RefreshCommand}" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[RefreshDevices]}" AutomationProperties.Name="{Binding Text[RefreshDevices]}" Style="{StaticResource SmallButton}"/>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,6,0,0">
     <Grid><TextBlock Text="{Binding LocalState}" Foreground="{Binding LocalBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding LevelText}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13"/></Grid>
     <controls:LevelMeter Level="{Binding Level}" Threshold="{Binding Settings.SpeakThreshold}" SilenceThreshold="{Binding Settings.SilenceThreshold}" Height="34" Margin="0,4,0,0" AutomationProperties.Name="{Binding Text[Local]}"/>
     <Grid Margin="0,-1,0,0"><TextBlock Text="−96 dBFS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0 dBFS" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Grid>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[SpeakTip]}">
      <Grid><TextBlock Text="{Binding Text[Speak]}" FontSize="12" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Settings.SpeakThreshold, StringFormat={}{0:0} dB}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource AccentBrush}"/></Grid>
      <Slider Style="{StaticResource CompactSlider}" Minimum="-90" Maximum="0" Value="{Binding Settings.SpeakThreshold}" AutomationProperties.Name="{Binding Text[Speak]}"/>
     </StackPanel>
     <StackPanel Grid.Column="2" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[SilenceTip]}">
      <Grid><TextBlock Text="{Binding Text[Silence]}" FontSize="12" Foreground="#89B8FF"/><TextBlock Text="{Binding Settings.SilenceThreshold, StringFormat={}{0:0} dB}" HorizontalAlignment="Right" FontSize="12" Foreground="#89B8FF"/></Grid>
      <Slider Style="{StaticResource CompactSlider}" Minimum="-96" Maximum="0" Value="{Binding Settings.SilenceThreshold}" AutomationProperties.Name="{Binding Text[Silence]}"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="4" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text[Attack]}" Style="{StaticResource Label}"/><Button Content="?" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[AttackTip]}" AutomationProperties.Name="{Binding Text[Attack]}" Padding="4,0" FontSize="10" Margin="6,0,0,0"/></StackPanel>
      <TextBox Text="{Binding Settings.AttackDelay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[AttackTip]}" AutomationProperties.Name="{Binding Text[Attack]}"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text[Release]}" Style="{StaticResource Label}"/><Button Content="?" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[ReleaseTip]}" AutomationProperties.Name="{Binding Text[Release]}" Padding="4,0" FontSize="10" Margin="6,0,0,0"/></StackPanel>
      <TextBox Text="{Binding Settings.ReleaseDelay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[ReleaseTip]}" AutomationProperties.Name="{Binding Text[Release]}"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="5" Margin="0,6,0,0" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[DuckTip]}">
     <Grid><TextBlock Text="{Binding Text[Duck]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Settings.DuckPercent, StringFormat={}{0:0} %}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" FontSize="12"/></Grid>
     <Slider Value="{Binding Settings.DuckPercent}" Minimum="1" Maximum="100" Style="{StaticResource CompactSlider}" AutomationProperties.Name="{Binding Text[Duck]}"/>
    </StackPanel>
    <Grid Grid.Row="6" x:Name="ShortcutSettings" Margin="0,5,0,0" VerticalAlignment="Top" ToolTip="{Binding Text[PushTip]}" ToolTipService.ShowDuration="30000">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="{Binding Text[PushAnyway]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding ShortcutStatus}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/></StackPanel>
 <Button Grid.Column="1" x:Name="ShortcutRecordButton" Click="RecordShortcut" Style="{StaticResource SmallButton}" Margin="10,0,0,0" ToolTip="{Binding Text[RecordHint]}" AutomationProperties.Name="{Binding Text[RecordTitle]}">
  <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text[RecordShortcut]}" FontSize="11" Margin="0,0,10,0"/><TextBlock Text="{Binding Settings.ShortcutLabel}" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis"/></StackPanel>
 </Button>
</Grid>
<StackPanel x:Name="AudioActions" Grid.Row="7" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,10,0,0">
     <Button Content="{Binding Text[Mute]}" Command="{Binding MuteCommand}" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
     <Button Content="{Binding Text[Restore]}" Command="{Binding RestoreCommand}" Style="{StaticResource SmallButton}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Border Grid.Column="2" x:Name="NetworkCard" Style="{StaticResource Card}" Padding="16,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Text[Partner]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding PartnerName}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartnerName}" Margin="0,0,10,0"/>
     <TextBlock Grid.Column="1" Text="{Binding RemoteState}" Foreground="{Binding RemoteBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Grid>
    <StackPanel Grid.Row="2" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[IpTip]}">
     <TextBlock Text="{Binding Text[OwnIp]}" Style="{StaticResource Label}"/>
     <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding LocalAddresses}" SelectedItem="{Binding SelectedLocalAddress}" DisplayMemberPath="Address" Margin="0,0,6,0" AutomationProperties.Name="{Binding Text[OwnIp]}" ToolTip="{Binding LocalAddressTip}"/>
      <TextBlock Text="{Binding Text[NoAddress]}" FontSize="11" Margin="8,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LocalAddresses.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Button Grid.Column="1" Content="{Binding Text[Copy]}" Command="{Binding CopyIpCommand}" Style="{StaticResource SmallButton}" Margin="0,0,5,0"/>
      <Button Grid.Column="2" Content="↻" Command="{Binding RefreshNetworkCommand}" Style="{StaticResource SmallButton}" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[Refresh]}" AutomationProperties.Name="{Binding Text[Refresh]}"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,8"><TextBlock Text="{Binding Text[PcName]}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.ClientName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="{Binding Text[PcName]}"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,0,0,8"><TextBlock Text="{Binding Text[PartnerIp]}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.PartnerIp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text[PartnerIp]}"/></StackPanel>
    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Text[Port]}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text[Port]}"/></StackPanel>
     <StackPanel Grid.Column="2" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[PriorityTip]}"><TextBlock Text="{Binding Text[Priority]}" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Field}" Text="{Binding Settings.Priority, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text[Priority]}"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="7" Margin="0,12,0,0">
     <CheckBox Content="{Binding Text[FirstSpeaker]}" IsChecked="{Binding Settings.FirstSpeakerWins}" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[FirstTip]}" Style="{StaticResource CompactCheck}"/>
     <TextBlock Text="{Binding PriorityState}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>

 <Border Grid.Row="6" Background="#111A26" CornerRadius="10" Padding="12,9">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <CheckBox ToolTip="{Binding Text[StartupTip]}" ToolTipService.ShowDuration="30000" Content="{Binding Text[Startup]}" IsChecked="{Binding Settings.StartWithWindows}" Style="{StaticResource CompactCheck}" Margin="0,0,20,0"/>
    <CheckBox Content="{Binding Text[Tray]}" IsChecked="{Binding Settings.MinimizeToTray}" Style="{StaticResource CompactCheck}" Margin="0,0,20,0"/>
    <CheckBox Content="{Binding Text[Minimized]}" IsChecked="{Binding Settings.StartMinimized}" Style="{StaticResource CompactCheck}"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{StaticResource SmallButton}"/>
  </Grid>
 </Border>
 <Grid Grid.Row="8" x:Name="Footer"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0">
   <TextBlock Text="{Binding PendingText}" Foreground="{Binding PendingBrush}" FontSize="11" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[ApplyHint]}"/>
   <TextBlock Text="{Binding Notice}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" Margin="0,3,0,0"/>
   <TextBlock Text="{Binding Text[Privacy]}" Foreground="#71859E" FontSize="10" Margin="0,3,0,0"/>
  </StackPanel>
  <Button x:Name="ApplyButton" Grid.Column="1" Content="{Binding Text[Apply]}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" VerticalAlignment="Center" ToolTipService.ShowDuration="30000" ToolTip="{Binding Text[ApplyHint]}"/>
 </Grid>
</Grid>
</UserControl>






